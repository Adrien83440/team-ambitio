rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPERS

    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    function isCoach() {
      return isAuth() && getRole() == 'coach';
    }

    function isSales() {
      return isAuth() && getRole() == 'sales';
    }

    function isCoachOrAdmin() {
      return isAuth() && (getRole() == 'coach' || getRole() == 'admin');
    }

    function isSalesOrAdmin() {
      return isAuth() && (getRole() == 'sales' || getRole() == 'admin');
    }

    function isSelfOrAdmin(userId) {
      return isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // Helper : utilisateurs habilités à écouter les enregistrements
    // d'appels. Un flag booléen canListenCalls sur le doc users/{uid} accorde
    // l'accès lecture aux call_logs et aux enregistrements audio de tous les
    // closers. Les admins l'ont automatiquement.
    function canListenCalls() {
      return isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canListenCalls == true
      );
    }

    // Helper : utilisateurs habilités à créer/gérer des templates et des
    // demandes de signature électronique. Un flag booléen signaturesAccess
    // sur users/{uid} accorde l'accès aux sales qui doivent pouvoir envoyer
    // leurs propres signatures (ex : Élodie). Les admins l'ont auto.
    function canSignaturesAdmin() {
      return isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.signaturesAccess == true
      );
    }

    // Helper : l'utilisateur authentifié est-il propriétaire de la fiche
    // expert booking_config/{personId} ? Basé sur le champ firebaseUid
    // posé par l'admin depuis la page booking-admin. Utilisé pour gater
    // l'accès calendrier, tokens, sync et auth requests d'un expert à
    // son seul propriétaire. Si le personId n'existe pas ou que firebaseUid
    // n'a jamais été posé, retourne false (accès refusé).
    function ownsBookingPerson(personId) {
      return isAuth()
        && exists(/databases/$(database)/documents/booking_config/$(personId))
        && get(/databases/$(database)/documents/booking_config/$(personId)).data.firebaseUid == request.auth.uid;
    }


    // ═══ USERS ═══
    match /users/{userId} {
      allow read:  if isSelfOrAdmin(userId);
      allow write: if isAdmin();
    }


    // ═══ COACHING / CLIENTS ═══
    match /clients/{clientId} {
      allow read:           if isCoachOrAdmin();
      allow create, update: if isCoachOrAdmin();
      allow delete:         if isAdmin();
    }

    match /clients/{clientId}/files/{fileId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow delete: if isCoachOrAdmin();
    }

    // Plans d'action client (documents HTML attachés à la fiche coaching)
    // Lecture : coach + admin
    // Écriture (create/update/delete) : admin uniquement
    match /clients/{clientId}/plans/{planId} {
      allow read:           if isCoachOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ SAISIES SALES ═══
    match /saisies/{userId}/mois/{monthKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ COMMISSIONS ═══
    match /commissions/{userId}/mois/{monthKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }

    match /commissions/{userId}/total/{year} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }


    // ═══ MODULE EQUIPE ═══
    match /membres/{userId} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }

    match /membres/{userId}/notes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /membres/{userId}/documents/{docId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }

    match /membres/{userId}/messages/{msgId} {
      allow read:           if isSelfOrAdmin(userId);
      allow create:         if isAdmin();
      allow update, delete: if false;
    }

    match /membres/{userId}/calls/{callId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ MORNING MEETINGS ═══
    match /meetings/{meetingId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }

    match /meetings/{meetingId}/questions/{questionId} {
      allow read:   if isSalesOrAdmin();
      allow create: if isSalesOrAdmin();
      allow update, delete: if isAdmin();
    }


    // ═══ PROJECTIONS & ALERTES ═══
    match /projections/{monthKey} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }


    // ═══ COMMUNICATION (coaching) ═══
    match /messages_general/{messageId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_alarmes/{messageId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_suivi/{messageId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_admins/{messageId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_annonces/{messageId} {
      allow read:   if isCoachOrAdmin() || isSalesOrAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /alarms/{alarmId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if isCoachOrAdmin();
      allow delete: if isAdmin();
    }


    // ═══ EOD (End of Day) ═══
    match /eod/{userId}/jours/{dateKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ LEADS ═══
    match /leads/{leadId} {
      allow read:           if isSalesOrAdmin();
      allow create:         if true;
      allow update:         if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }

    match /leads/{leadId}/client_temoignages/{temoId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isSalesOrAdmin();
    }

    match /leads/{leadId}/client_notes/{noteId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isSalesOrAdmin();
    }


    // ═══ VOICE NOTES — fil de discussion audio par lead ═══
    // Lecture : sales + admin
    // Création : sales + admin (l'auteur authentifié pose authorUid = uid)
    // Update : auteur du vocal (pour permettre au backend Vercel d'updater
    //          via Admin SDK la transcription et le résumé) ou admin
    // Suppression : auteur ou admin
    //
    // Note : la Vercel Function api/transcribe-voice.js utilise le Firebase
    // Admin SDK et bypass naturellement ces rules pour poser transcription
    // et summary après traitement Whisper + Claude Haiku.
    match /leads/{leadId}/voice_notes/{noteId} {
      allow read:   if isSalesOrAdmin();
      allow create: if isSalesOrAdmin()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isSalesOrAdmin() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin()
                    || (isSalesOrAdmin() && resource.data.authorUid == request.auth.uid);
    }


    // ═══ META ═══
    match /_meta/{docId} {
      allow read, write: if isSalesOrAdmin();
    }


    // ═══ BOOKING ═══
    match /booking_config/{docId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.firebaseUid == request.auth.uid
            && request.resource.data.firebaseUid == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read:   if true;
      allow create: if true;
      allow update: if isSalesOrAdmin();
      allow delete: if isAdmin();
    }

    match /booking_events/{eventId} {
      allow read:   if isSalesOrAdmin();
      allow create: if true;
      allow update: if isSalesOrAdmin();
      allow delete: if isAdmin();
    }


    // ═══ GOOGLE CALENDAR ═══
    match /calendar_tokens/{personId} {
      allow read, write: if isAdmin() || ownsBookingPerson(personId);
    }

    match /calendar_extra_tokens/{docId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.personId != null
            && ownsBookingPerson(resource.data.personId));
      allow create, update: if false;
      allow delete: if isAdmin()
        || (isAuth() && resource.data.personId != null
            && ownsBookingPerson(resource.data.personId));
    }

    match /calendar_auth_requests/{requestId} {
      allow read:   if isAdmin()
        || (isAuth() && ownsBookingPerson(resource.data.personId));
      allow create: if isAdmin()
        || (isAuth() && ownsBookingPerson(request.resource.data.personId));
      allow update: if false;
      allow delete: if isAdmin()
        || (isAuth() && ownsBookingPerson(resource.data.personId));
    }

    match /calendar_busy/{personId} {
      allow read: if true;
    }

    match /calendar_sync_requests/{personId} {
      allow read:  if true;
      allow write: if isAdmin() || ownsBookingPerson(personId);
    }


    // ═══ INTERNAL CONFIG ═══
    match /_config/oauth_calendar {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /_config/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }


    // ═══ EMAIL ═══
    match /email_tokens/{accountKey} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /email_auth_requests/{requestId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }


    // ═══ FCM TOKENS ═══
    match /fcm_tokens/{tokenId} {
      allow read:   if isSalesOrAdmin();
      allow create, update: if true;
      allow delete: if isSalesOrAdmin();
    }


    // ═══ CRM ═══
    match /crm_views/{viewId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isSalesOrAdmin();
    }

    match /crm_roles/{roleId} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }

    match /crm_profiles/{profileId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }


    // ═══ WEBHOOK INBOX ═══
    match /webhook_inbox/{docId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ═══ ALTEOFORMS ═══
    match /alteo_forms/{formId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /alteo_forms/{formId}/responses/{responseId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }


    // ═══ SIGNATURES ═══
    // Accès admin + sales avec flag signaturesAccess == true sur users/{uid}.
    // Les lectures + update restent ouvertes (signed_pdf créé par le prospect
    // non-authentifié côté sign.html).
    match /signature_templates/{tplId} {
      allow read:  if true;
      allow write: if canSignaturesAdmin();
    }

    match /signature_templates/{tplId}/pdf/{chunkId} {
      allow read:  if true;
      allow write: if canSignaturesAdmin();
    }

    match /signature_requests/{reqId} {
      allow read:   if true;
      allow create: if canSignaturesAdmin();
      allow update: if true;
      allow delete: if canSignaturesAdmin();
    }

    match /signature_requests/{reqId}/signed_pdf/{chunkId} {
      allow read:   if true;
      allow create: if true;
      allow delete: if canSignaturesAdmin();
    }


    // ═══ AUDIT LOG ═══
    match /audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }


    // ═══ DIALER — PHONE NUMBERS ═══
    match /phone_numbers/{numberId} {
      allow read:           if isAuth();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ DIALER — SESSIONS ═══
    match /dialer_sessions/{sessionId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSalesOrAdmin()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }


    // ═══ DIALER — CAMPAIGNS ═══
    match /dialer_campaigns/{campaignId} {
      allow read: if isAuth() && (
        isAdmin() ||
        request.auth.uid in resource.data.assignedUserIds
      );
      allow create: if isSalesOrAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }


    // ═══ DIALER — CALL LOGS ═══
    match /call_logs/{callLogId} {
      allow read: if isAuth() && (
        canListenCalls() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }


    // ═══ PAYMENTS ═══
    match /payments/{paymentId} {
      allow read:   if isSalesOrAdmin();
      allow create: if isSalesOrAdmin();
      allow update: if isAdmin() || (isSalesOrAdmin() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }


    // ═══ INBOX NOTIFICATIONS — SMS/appels entrants temps réel ═══
    // Alimentée backend par : api/twilio-sms-inbound, api/twilio-inbound,
    //                        Cloud Function onWebhookInbox (Ringover + Twilio status).
    //
    // Visibilité :
    //   - admin : voit toutes les notifs
    //   - sales : voit uniquement les notifs où ownerUid == son uid
    //   - coach : pas d'accès (le widget ne se monte pas pour eux côté UI,
    //             et ces rules le bloquent aussi côté serveur par sécurité)
    //
    // Update : autorisé pour marquer "lu" (écriture dans readBy.{uid}).
    // Pas de gating fin sur le champ touché — les rules Firestore ne
    // permettent pas de restreindre proprement les map keys, et le seul
    // "abus" possible est qu'un sales modifie une notif lui appartenant
    // déjà : risque acceptable.
    match /inbox_notifications/{notifId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if false;   // Admin SDK uniquement (Vercel + Cloud Functions)
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

  }
}
