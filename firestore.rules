rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPERS

    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    function isCoach() {
      return isAuth() && getRole() == 'coach';
    }

    function isSales() {
      return isAuth() && getRole() == 'sales';
    }

    function isCoachOrAdmin() {
      return isAuth() && (getRole() == 'coach' || getRole() == 'admin');
    }

    function isCsm() {
      return isAuth() && getRole() == 'csm';
    }

    // CSM peut lire/mettre à jour les fiches clients (coaching) pour gérer
    // les notes CSM et relances sur les "coaching only" (clients qui ont
    // une fiche coaching mais pas de lead correspondant). Elle ne peut PAS
    // créer/supprimer de fiche coaching (c'est le rôle des coachs).
    function isCoachOrAdminOrCsm() {
      return isAuth() && (getRole() == 'coach' || getRole() == 'admin' || getRole() == 'csm');
    }

    function isSalesOrAdmin() {
      return isAuth() && (getRole() == 'sales' || getRole() == 'admin');
    }

    // CSM peut lire les leads (dashboard CSM = leads where isClient) et
    // update certains champs (notes, relances, statut client). Pour create,
    // c'est ouvert car rules existantes (allow create: if true).
    function isSalesOrAdminOrCsm() {
      return isAuth() && (getRole() == 'sales' || getRole() == 'admin' || getRole() == 'csm');
    }

    function isSelfOrAdmin(userId) {
      return isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // Helper : utilisateurs habilités à écouter les enregistrements
    // d'appels. Un flag booléen canListenCalls sur le doc users/{uid} accorde
    // l'accès lecture aux call_logs et aux enregistrements audio de tous les
    // closers. Les admins l'ont automatiquement.
    function canListenCalls() {
      return isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canListenCalls == true
      );
    }

    // Helper : utilisateurs habilités à créer/gérer des templates et des
    // demandes de signature électronique. Un flag booléen signaturesAccess
    // sur users/{uid} accorde l'accès aux sales qui doivent pouvoir envoyer
    // leurs propres signatures (ex : Élodie). Les admins l'ont auto.
    function canSignaturesAdmin() {
      return isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.signaturesAccess == true
      );
    }

    // Helper : droit de DÉCLENCHEMENT des prélèvements GoCardless. Un flag
    // booléen paymentsTrigger sur users/{uid} donne la LECTURE de tous les
    // paiements (retrouver celui à déclencher) — le déclenchement lui-même
    // passe par l'endpoint Vercel gocardless-payment (Admin SDK, gate
    // requirePaymentsTrigger). Ne donne NI création, NI update, NI
    // suppression : créer / lien mandat / annuler restent admin (+ sales
    // sur ses propres paiements, régime historique). Admins : automatique.
    function canTriggerPayments() {
      return isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.paymentsTrigger == true
      );
    }

    // Helper : l'utilisateur authentifié est-il propriétaire de la fiche
    // expert booking_config/{personId} ? Basé sur le champ firebaseUid
    // posé par l'admin depuis la page booking-admin. Utilisé pour gater
    // l'accès calendrier, tokens, sync et auth requests d'un expert à
    // son seul propriétaire. Si le personId n'existe pas ou que firebaseUid
    // n'a jamais été posé, retourne false (accès refusé).
    function ownsBookingPerson(personId) {
      return isAuth()
        && exists(/databases/$(database)/documents/booking_config/$(personId))
        && get(/databases/$(database)/documents/booking_config/$(personId)).data.firebaseUid == request.auth.uid;
    }


    // ═══ USERS ═══
    match /users/{userId} {
      allow read:  if isSelfOrAdmin(userId);
      allow write: if isAdmin();
    }


    // ═══ COACHING / CLIENTS ═══
    match /clients/{clientId} {
      // CSM peut lire (pour voir tous les clients coaching dans le dashboard
      // CSM, y compris les "coaching only") et update (pour notes csmNotes,
      // relances csmFollowupHistory, lastCsmFollowupAt, clientStatus). Le
      // create reste coach+admin pour préserver l'intégrité des fiches.
      allow read:    if isCoachOrAdminOrCsm();
      allow create:  if isCoachOrAdmin();
      allow update:  if isCoachOrAdminOrCsm();
      allow delete:  if isAdmin();
    }

    match /clients/{clientId}/files/{fileId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow delete: if isCoachOrAdmin();
    }

    // Plans d'action client (documents HTML attachés à la fiche coaching)
    // Lecture : coach + admin
    // Écriture (create/update/delete) : admin uniquement
    match /clients/{clientId}/plans/{planId} {
      allow read:           if isCoachOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ SAISIES SALES ═══
    match /saisies/{userId}/mois/{monthKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ COMMISSIONS ═══
    match /commissions/{userId}/mois/{monthKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }

    match /commissions/{userId}/total/{year} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }


    // ═══ MODULE EQUIPE ═══
    match /membres/{userId} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }

    match /membres/{userId}/notes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /membres/{userId}/documents/{docId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }

    match /membres/{userId}/messages/{msgId} {
      allow read:           if isSelfOrAdmin(userId);
      allow create:         if isAdmin();
      allow update, delete: if false;
    }

    match /membres/{userId}/calls/{callId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ MORNING MEETINGS ═══
    match /meetings/{meetingId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }

    match /meetings/{meetingId}/questions/{questionId} {
      allow read:   if isSalesOrAdmin();
      allow create: if isSalesOrAdmin();
      allow update, delete: if isAdmin();
    }


    // ═══ PROJECTIONS & ALERTES ═══
    match /projections/{monthKey} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }


    // ═══ COMMUNICATION (coaching) ═══
    match /messages_general/{messageId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_alarmes/{messageId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_suivi/{messageId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_admins/{messageId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages_annonces/{messageId} {
      allow read:   if isCoachOrAdmin() || isSalesOrAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /alarms/{alarmId} {
      allow read:   if isCoachOrAdmin();
      allow create: if isCoachOrAdmin();
      allow update: if isCoachOrAdmin();
      allow delete: if isAdmin();
    }


    // ═══ EOD (End of Day) ═══
    match /eod/{userId}/jours/{dateKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ LEAD ACTIONS — journal des actions setting (refonte 07/2026) ═══
    // Une action = un événement immuable écrit par alteore-flow.js à chaque
    // changement de statut sur la fiche prospect (NRP1, SET, RDV posé…).
    // Alimente le rapport Setting journalier (Total Leads, NRP1/2/3, Sets)
    // et l'agrégat SETTING/CLOSING du Funnel.
    // Path : lead_actions/{memberSlug}/items/{actionId}
    match /lead_actions/{memberSlug}/items/{actionId} {
      allow read:   if isSalesOrAdmin();
      allow create: if isSalesOrAdmin();
      allow update: if false;   // journal immuable — on corrige via rapport_overrides
      allow delete: if isAdmin();
    }


    // ═══ RAPPORT OVERRIDES — corrections manuelles par jour ═══
    // Les rapports Setting/Closing sont calculés automatiquement (Ringover,
    // lead_actions, bookings). En cas d'anomalie, une correction ponctuelle
    // par jour et par champ est stockée ici (jamais dans les données brutes).
    // Path : rapport_overrides/{memberSlug}/jours/{YYYY-MM-DD}
    match /rapport_overrides/{memberSlug}/jours/{dayKey} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ LEADS ═══
    match /leads/{leadId} {
      // CSM peut read les leads (dashboard) et update (notes/relances/status)
      allow read:           if isSalesOrAdminOrCsm();
      allow create:         if true;
      allow update:         if isSalesOrAdminOrCsm();
      allow delete:         if isAdmin();
    }

    match /leads/{leadId}/client_temoignages/{temoId} {
      allow read:           if isSalesOrAdminOrCsm();
      allow create, update: if isSalesOrAdminOrCsm();
      allow delete:         if isSalesOrAdminOrCsm();
    }

    match /leads/{leadId}/client_notes/{noteId} {
      allow read:           if isSalesOrAdminOrCsm();
      allow create, update: if isSalesOrAdminOrCsm();
      allow delete:         if isSalesOrAdminOrCsm();
    }


    // ═══ VOICE NOTES — fil de discussion audio par lead ═══
    // Lecture : sales + admin
    // Création : sales + admin (l'auteur authentifié pose authorUid = uid)
    // Update : auteur du vocal (pour permettre au backend Vercel d'updater
    //          via Admin SDK la transcription et le résumé) ou admin
    // Suppression : auteur ou admin
    //
    // Note : la Vercel Function api/transcribe-voice.js utilise le Firebase
    // Admin SDK et bypass naturellement ces rules pour poser transcription
    // et summary après traitement Whisper + Claude Haiku.
    match /leads/{leadId}/voice_notes/{noteId} {
      allow read:   if isSalesOrAdmin();
      allow create: if isSalesOrAdmin()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isSalesOrAdmin() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin()
                    || (isSalesOrAdmin() && resource.data.authorUid == request.auth.uid);
    }


    // ═══ META ═══
    // Lecture ouverte à tout utilisateur authentifié : _meta/team_members
    // est la source de vérité du roster équipe (nav.js → loadTeamMembers)
    // et doit être lisible par TOUS les rôles (coach, csm inclus). Sinon
    // les pages coaching retombent sur le fallback hardcodé de nav.js
    // (roster périmé — ex : Thomas voyait encore Mickael).
    // Écriture inchangée : sales + admin.
    match /_meta/{docId} {
      allow read:  if isAuth();
      allow write: if isSalesOrAdmin();
    }


    // ═══ BOOKING ═══
    match /booking_config/{docId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.firebaseUid == request.auth.uid
            && request.resource.data.firebaseUid == request.auth.uid);
    }

    match /bookings/{bookingId} {
      // CSM accède au module booking-admin en lecture seule globale mais
      // peut annuler / changer le statut d'un RDV à la demande d'un client
      // (rôle Customer Success). Cf. booking-admin.html mode csm.
      allow read:   if true;
      allow create: if true;
      allow update: if isSalesOrAdminOrCsm();
      allow delete: if isAdmin();
    }

    match /booking_events/{eventId} {
      // Lecture étendue à la CSM pour afficher la timeline d'audit d'un RDV
      // dans le panel détail (booking-admin.html → openRdvDetail → tab audit).
      allow read:   if isSalesOrAdminOrCsm();
      allow create: if true;
      allow update: if isSalesOrAdmin();
      allow delete: if isAdmin();
    }


    // ═══ GOOGLE CALENDAR ═══
    match /calendar_tokens/{personId} {
      allow read, write: if isAdmin() || ownsBookingPerson(personId);
    }

    match /calendar_extra_tokens/{docId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.personId != null
            && ownsBookingPerson(resource.data.personId));
      allow create, update: if false;
      allow delete: if isAdmin()
        || (isAuth() && resource.data.personId != null
            && ownsBookingPerson(resource.data.personId));
    }

    match /calendar_auth_requests/{requestId} {
      allow read:   if isAdmin()
        || (isAuth() && ownsBookingPerson(resource.data.personId));
      allow create: if isAdmin()
        || (isAuth() && ownsBookingPerson(request.resource.data.personId));
      allow update: if false;
      allow delete: if isAdmin()
        || (isAuth() && ownsBookingPerson(resource.data.personId));
    }

    match /calendar_busy/{personId} {
      allow read: if true;
    }

    match /calendar_sync_requests/{personId} {
      allow read:  if true;
      allow write: if isAdmin() || ownsBookingPerson(personId);
    }


    // ═══ INTERNAL CONFIG ═══
    match /_config/oauth_calendar {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /_config/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ═══ FACTURATION — CGV (sous-collection de _config/billing) ═══
    // Lue à CHAQUE boot de admin-invoice-edit.html (CGV active) et gérée
    // depuis l'onglet Paramètres de admin-facturation.html (versions CGV).
    // Rappel : les rules ne cascadent JAMAIS — match /_config/{docId}
    // ci-dessus ne couvre PAS cette sous-collection. Sans ce bloc, la
    // page Édition facture meurt au chargement (permission-denied) et
    // l'envoi d'email de facture est impossible (incident du 22/07/2026).
    match /_config/billing/cgv/{cgvId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }


    // ═══ EMAIL ═══
    match /email_tokens/{accountKey} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /email_auth_requests/{requestId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }


    // ═══ FCM TOKENS ═══
    match /fcm_tokens/{tokenId} {
      allow read:   if isSalesOrAdmin();
      allow create, update: if true;
      allow delete: if isSalesOrAdmin();
    }


    // ═══ CRM ═══
    match /crm_views/{viewId} {
      allow read:           if isSalesOrAdmin();
      allow create, update: if isSalesOrAdmin();
      allow delete:         if isSalesOrAdmin();
    }

    match /crm_roles/{roleId} {
      allow read:  if isSalesOrAdmin();
      allow write: if isAdmin();
    }

    match /crm_profiles/{profileId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }


    // ═══ WEBHOOK INBOX ═══
    match /webhook_inbox/{docId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ═══ ALTEOFORMS ═══
    match /alteo_forms/{formId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /alteo_forms/{formId}/responses/{responseId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // ═══ ALTEOFORMS — BROUILLONS « Finir plus tard » (07/2026) ═══
    // Écrits UNIQUEMENT par la Vercel Function api/alteoform-draft.js
    // (Admin SDK, bypass des rules). Le draftId est un token secret
    // aléatoire (24 octets base64url) envoyé par email au répondant —
    // jamais lisible côté client anonyme : toute lecture publique passe
    // par l'endpoint. Lecture admin : section « ⏳ Sauvegardes en cours »
    // de l'onglet Réponses du builder. Suppression admin : bouton 🗑 de
    // cette même section. Un brouillon est supprimé automatiquement à la
    // soumission du formulaire (action consume, Admin SDK).
    match /alteo_forms/{formId}/drafts/{draftId} {
      allow read:           if isAdmin();
      allow create, update: if false;   // Admin SDK uniquement
      allow delete:         if isAdmin();
    }


    // ═══ SIGNATURES ═══
    // Accès admin + sales avec flag signaturesAccess == true sur users/{uid}.
    // Les lectures + update restent ouvertes (signed_pdf créé par le prospect
    // non-authentifié côté sign.html).
    match /signature_templates/{tplId} {
      allow read:  if true;
      allow write: if canSignaturesAdmin();
    }

    match /signature_templates/{tplId}/pdf/{chunkId} {
      allow read:  if true;
      allow write: if canSignaturesAdmin();
    }

    match /signature_requests/{reqId} {
      allow read:   if true;
      allow create: if canSignaturesAdmin();
      allow update: if true;
      allow delete: if canSignaturesAdmin();
    }

    match /signature_requests/{reqId}/signed_pdf/{chunkId} {
      allow read:   if true;
      allow create: if true;
      allow delete: if canSignaturesAdmin();
    }


    // ═══ AUDIT LOG ═══
    match /audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }


    // ═══ DEDUP_BACKUPS — sauvegarde avant fusion de doublons ═══
    // Écrite par clients-dedup.html (doMerge, étape 1) AVANT toute
    // modification : snapshots complets des docs du cluster, de leurs
    // sous-collections et des paiements rattachés. C'est la seule copie
    // qui permette de revenir en arrière sur une fusion.
    //
    // Cette collection n'avait AUCUN bloc match — les rules ne cascadent
    // jamais, donc l'écriture était refusée et la chaîne de promesses de
    // doMerge s'interrompait dès l'étape 1 : plus aucune fusion possible
    // depuis la page. Même classe d'oubli que _config/billing/cgv (22/07).
    //
    // Création + lecture admin. Jamais de update ni de delete : une
    // sauvegarde modifiable ne prouve plus rien.
    match /dedup_backups/{backupId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }


    // ═══ PERSONS — identité unifiée inter-modules (Sync Step 2) ═══
    // Collection canonique de l'identité humaine, partagée entre leads,
    // clients (coaching), invoice_clients, payments, subscriptions.
    // Master des champs identité personne (nom, email, telephone) et hub
    // de la sync inter-modules.
    //
    // Lecture : sales + admin + csm (utile pour le dashboard CSM unifié).
    // Écriture : admin uniquement en Step 2 (la Cloud Function de sync
    //   utilisera Admin SDK qui bypass les rules).
    // Suppression : jamais — règle "aucune donnée supprimée" du projet.
    match /persons/{personId} {
      allow read:           if isSalesOrAdminOrCsm();
      allow create, update: if isAdmin();
      allow delete:         if false;
    }


    // ═══ INVOICE_CLIENTS — fiches clients de facturation (Sync Step 6.1) ═══
    // Bloc ajouté pour permettre la lecture côté SDK client depuis
    // admin-persons.html (vue unifiée 360° d'un humain). Les Vercel
    // Functions de facturation continuent d'utiliser Admin SDK et
    // bypass naturellement ces rules.
    //
    // Lecture : sales + admin + csm.
    // Écriture : admin uniquement.
    match /invoice_clients/{clientId} {
      allow read:           if isSalesOrAdminOrCsm();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ SUBSCRIPTIONS — abonnements GoCardless (Sync Step 6.1) ═══
    // Bloc ajouté pour permettre la lecture côté SDK client depuis
    // admin-persons.html. Les Vercel Functions de facturation continuent
    // d'écrire via Admin SDK.
    //
    // Lecture : sales + admin + csm.
    // Écriture : admin uniquement.
    match /subscriptions/{subscriptionId} {
      allow read:           if isSalesOrAdminOrCsm();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ INVOICES — factures ═══
    // Collection lue et éditée côté SDK client depuis admin-facturation.html
    // (listing + suppression de brouillon) et admin-invoice-edit.html
    // (création + édition de brouillon). Ces deux pages sont réservées au
    // rôle admin (perm '_admin' dans nav.js + garde role==='admin' dans
    // admin-invoice-edit.html). Les Vercel Functions de facturation
    // (invoice-validate, invoice-pdf, subscription-generate-invoice, etc.)
    // écrivent via Admin SDK et bypassent naturellement ces rules.
    //
    // Lecture + écriture : admin uniquement.
    match /invoices/{invoiceId} {
      allow read:           if isAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ INVOICE_PRODUCTS — catalogue produits de facturation ═══
    // Lu et géré côté SDK client depuis l'onglet Produits de
    // admin-facturation.html (et lu par admin-invoice-edit.html pour le
    // sélecteur de produits). Pages réservées au rôle admin.
    //
    // Lecture + écriture : admin uniquement.
    match /invoice_products/{productId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }


    // ═══ FACTURATION — ALERTES (matching paiements ↔ factures) ═══
    // Créées par les Vercel Functions (Admin SDK, bypass rules) quand le
    // matching paiement → facture échoue. Le client admin-facturation.html
    // (onglet Alertes) les lit en temps réel et les résout/réouvre.
    // create/delete restent réservés au serveur.
    match /_alerts/{groupId}/items/{alertId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
    }


    // ═══ DIALER — PHONE NUMBERS ═══
    match /phone_numbers/{numberId} {
      allow read:           if isAuth();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ DIALER — SESSIONS ═══
    match /dialer_sessions/{sessionId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSalesOrAdmin()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }


    // ═══ DIALER — CAMPAIGNS ═══
    match /dialer_campaigns/{campaignId} {
      allow read: if isAuth() && (
        isAdmin() ||
        request.auth.uid in resource.data.assignedUserIds
      );
      allow create: if isSalesOrAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }


    // ═══ DIALER — CALL LOGS ═══
    match /call_logs/{callLogId} {
      allow read: if isAuth() && (
        canListenCalls() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }


    // ═══ PAYMENTS ═══
    match /payments/{paymentId} {
      allow read:   if isSalesOrAdmin() || canTriggerPayments();
      allow create: if isSalesOrAdmin();
      allow update: if isAdmin() || (isSalesOrAdmin() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }


    // ═══ INBOX NOTIFICATIONS — SMS/appels entrants temps réel ═══
    // Alimentée backend par : api/twilio-sms-inbound, api/twilio-inbound,
    //                        Cloud Function onWebhookInbox (Ringover + Twilio status).
    //
    // Visibilité :
    //   - admin : voit toutes les notifs
    //   - sales : voit uniquement les notifs où ownerUid == son uid
    //   - coach : pas d'accès (le widget ne se monte pas pour eux côté UI,
    //             et ces rules le bloquent aussi côté serveur par sécurité)
    //
    // Update : autorisé pour marquer "lu" (écriture dans readBy.{uid}).
    // Pas de gating fin sur le champ touché — les rules Firestore ne
    // permettent pas de restreindre proprement les map keys, et le seul
    // "abus" possible est qu'un sales modifie une notif lui appartenant
    // déjà : risque acceptable.
    match /inbox_notifications/{notifId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if false;   // Admin SDK uniquement (Vercel + Cloud Functions)
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }


    // ═══ ADS INSIGHTS — métriques pub Meta (Funnel Sales) ═══
    // 1 doc / jour / tunnel : ads_insights/{YYYY-MM-DD}_{tunnel}.
    // Écrit par : api/ads-metrics-ingest.js (Make → Admin SDK, bypass
    // naturel des rules) ET par la grille de saisie manuelle de
    // sales-funnel.html (SDK client, rôle admin). Page admin only.
    match /ads_insights/{docId} {
      allow read:           if isAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ ADS INSIGHTS AD-LEVEL — dépense PAR CRÉATIVE (17/08/2026) ═══
    // 1 doc / jour / pub : ads_insights_ad/{YYYY-MM-DD}_{ad_id}.
    // ads_insights est agrégé jour × tunnel et ne peut donc mécaniquement
    // pas produire un coût par créative : c'est cette collection qui
    // alimente les colonnes Dépense / CPL / ROAS de la section 🎨.
    // Écrit UNIQUEMENT par api/ads-creatives-ingest.js (Admin SDK, bypass) ;
    // lu par sales-funnel.html (SDK client, rôle admin).
    match /ads_insights_ad/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }


    // ═══ ADS CREATIVES — référentiel ad_id → nom de pub (17/08/2026) ═══
    // ads_creatives/{ad_id} : { ad_id, ad_name, adset_id, adset_name,
    // campaign_id, campaign_name }. Sert à rendre lisibles les UTM qui ne
    // portent qu'un identifiant Meta (template réglé sur {{ad.id}}) —
    // les lignes « 120246655604620308 » de la section 🎨.
    // Écrit UNIQUEMENT par api/ads-creatives-ingest.js (Admin SDK, bypass).
    match /ads_creatives/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }


    // ═══ INSTAGRAM — insights du compte, publications, commentaires, DM ═══
    // (01/09/2026) Alimente l'onglet 📸 Instagram du Funnel Sales.
    //
    // Écrit UNIQUEMENT côté serveur — api/instagram-sync-cron.js (cron
    // quotidien) et api/instagram-webhook.js (temps réel), tous deux via
    // l'Admin SDK, qui contourne naturellement ces rules. Le client ne fait
    // que lire : `write: false` n'est donc pas une restriction gênante, c'est
    // la garantie qu'aucune page ne pourra corrompre une métrique.
    //
    // Rappel : les rules ne cascadent JAMAIS. Chaque collection a son bloc.

    // 1 doc / jour : ig_account_daily/{YYYY-MM-DD}. Abonnés, portée, visites
    // de profil, clics sur le lien en bio. Meta ne conserve ces chiffres que
    // ~30 jours en arrière : ces documents SONT l'historique long.
    match /ig_account_daily/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / publication : ig_media/{mediaId} — dernier état connu.
    match /ig_media/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / publication / jour : ig_media_daily/{mediaId}_{YYYY-MM-DD}.
    // Permet de lire la VITESSE d'un post (« 12 000 vues en 48 h »), que le
    // seul dernier état ne peut pas donner.
    match /ig_media_daily/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / commentaire : ig_comments/{commentId}, avec le drapeau `isGo`.
    // C'est ce qui transforme « 84 commentaires » en « 61 personnes ont dit
    // GO » — le signal d'intérêt réel sous une publication.
    match /ig_comments/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / conversation : ig_dm_threads/{igsid}. Compteurs entrants /
    // sortants, réponse ou non, délai. Aucune API Meta ne rend ces chiffres
    // rétroactivement : ils n'existent que parce que le webhook les a
    // journalisés au fil de l'eau.
    match /ig_dm_threads/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / message : ig_dm_events/{mid}. Journal brut, garant de
    // l'idempotence quand Meta rejoue un webhook.
    match /ig_dm_events/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }


    // ═══ FACEBOOK — Page, publications, commentaires, Messenger ═══
    // (01/09/2026) Alimente l'onglet 📘 Facebook du Funnel Sales.
    //
    // Écrit UNIQUEMENT côté serveur — api/facebook-sync-cron.js (cron
    // quotidien, qui fait autorité) et api/facebook-webhook.js (temps réel,
    // qui ne fait que tenir l'écran à jour entre deux passages), tous deux
    // via l'Admin SDK. Le client ne fait que lire.
    //
    // Rappel : les rules ne cascadent JAMAIS. Chaque collection a son bloc.

    // 1 doc / jour : fb_page_daily/{YYYY-MM-DD}. Portée, impressions,
    // engagements, vues de la Page, abonnés.
    match /fb_page_daily/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / publication : fb_posts/{postId} — dernier état connu.
    match /fb_posts/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / publication / jour : fb_post_daily/{postId}_{YYYY-MM-DD}.
    match /fb_post_daily/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / commentaire : fb_comments/{commentId}, avec le drapeau `isGo`.
    // `filter=stream` rend les réponses à plat : un GO écrit en réponse est
    // ici un document comme un autre.
    match /fb_comments/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / conversation Messenger : fb_dm_threads/{conversationId}.
    // Contrairement à Instagram, l'historique est rattrapable : ces
    // documents ne dépendent pas du seul webhook pour exister.
    match /fb_dm_threads/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // 1 doc / message Messenger : fb_dm_events/{messageId}. Journal brut,
    // garant de l'idempotence quand Meta rejoue un webhook.
    match /fb_dm_events/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }


    // ═══ MARKETING JOURNAL — tableau d'actions marketing (Funnel) ═══
    // Journal « telle date, tel changement » : consigné et lu depuis
    // sales-funnel.html (admin only).
    match /marketing_journal/{docId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ═══ PAGE VIEWS — vues des pages d'opt-in (beacon system.io) ═══
    // Compteurs journaliers page_views_daily/{YYYY-MM-DD}_{page},
    // incrémentés UNIQUEMENT par api/page-view.js (Admin SDK, bypass).
    // Aucune écriture SDK client possible.
    match /page_views_daily/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }


    // ═══ FUNNEL SNAPSHOTS — OBSOLÈTE (26/07/2026) ═══
    // Mécanisme d'instantanés pré-publiés, remplacé par le calcul à la
    // demande : api/agency-funnel.js exécute funnel-core.js (le module que
    // fait aussi tourner sales-funnel.html) pour la période demandée. Plus
    // rien n'écrit ici, et aucune copie des chiffres n'est stockée.
    // Bloc conservé en admin-only le temps de purger les documents restants
    // depuis la Console — supprimable ensuite avec la collection.
    match /funnel_snapshots/{monthKey} {
      allow read:           if isAdmin();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }


    // ═══ AVAILABILITY DAILY — archive de la capacité sales (08/2026) ═══
    // Un doc par expert et par mois : availability_daily/{personId}__{YYYY-MM},
    // champ `days` = { 'YYYY-MM-DD': {open, booked, perso, free, work,
    // final, approx} }, en créneaux d'1 h.
    //
    // POURQUOI CETTE COLLECTION EXISTE
    // booking_config ne garde que les horaires ACTUELS d'un expert. Quand
    // Élodie retire des heures, l'ancienne capacité disparaît : impossible de
    // dire après coup combien de créneaux étaient ouverts le mois dernier.
    // Le cron api/availability-snapshot.js fige donc chaque nuit ce qui était
    // réellement ouvert / pris / libre. C'est la mémoire que lit la section
    // « Capacité & dispos » de sales-funnel.html.
    //
    // Écriture : cron Vercel via Admin SDK → bypass naturel de ces rules,
    // d'où `create, update: if false` côté client. Aucun écran n'écrit ici :
    // un chiffre d'archive ne doit jamais pouvoir être retouché depuis le
    // navigateur, sinon l'historique ne vaut plus rien.
    //
    // Lecture : admin uniquement (sales-funnel.html est déjà admin-only, même
    // régime que ads_insights / marketing_journal / funnel_snapshots).
    //
    // ⚠ Sans ce bloc, le refus par défaut s'applique : la section affiche
    // « Archive inaccessible » et tous les jours passés retombent en
    // « estimé » — silencieusement faux si on ne le dit pas, d'où le message
    // explicite à l'écran.
    match /availability_daily/{docId} {
      allow read:           if isAdmin();
      allow create, update: if false;   // Admin SDK (cron) uniquement
      allow delete:         if isAdmin();
    }

    // ─── BOÎTE WHATSAPP PARTAGÉE ─────────────────────────────────────────
    // Un seul numéro pour toute l'entreprise, donc une seule boîte. Réservée
    // aux rôles `sales` et `admin` — même régime que le Dialer : un coach ou
    // la CSM n'y a jamais accès.
    //
    // Écriture réservée à l'Admin SDK (webhook et endpoints Vercel), qui
    // contourne naturellement ces rules. Le navigateur ne fait que LIRE :
    // un message ne doit jamais pouvoir être fabriqué ou réécrit depuis un
    // onglet, sinon le fil cesse d'être une preuve de ce qui a été envoyé.
    // Seul `nonLus` fait exception — le marquage « lu » vient de l'écran.
    match /whatsapp_conversations/{numero} {
      allow read:   if isSalesOrAdmin();
      allow create: if false;                       // Admin SDK uniquement
      allow update: if isSalesOrAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nonLus', 'attribueA', 'statut', 'luA']);
      allow delete: if false;                       // rien ne se supprime
    }

    // ⚠ Les rules ne cascadent JAMAIS du parent vers la sous-collection.
    // Sans ce bloc, le fil de discussion serait illisible et la page
    // afficherait des conversations vides — l'incident du 22/07/2026 sur
    // _config/billing/cgv est né exactement de cet oubli.
    match /whatsapp_conversations/{numero}/messages/{wamid} {
      allow read:                   if isSalesOrAdmin();
      allow create, update, delete:  if false;      // Admin SDK uniquement
    }

    // Journal technique des envois et messages entrants bruts. Lecture pour
    // le dépannage, écriture jamais : ce sont les traces qui permettent de
    // répondre à « le client dit qu'il n'a rien reçu ».
    match /whatsapp_messages/{wamid} {
      allow read:                   if isSalesOrAdmin();
      allow create, update, delete:  if false;      // Admin SDK uniquement
    }

    match /whatsapp_inbound/{wamid} {
      allow read:                   if isSalesOrAdmin();
      allow create, update, delete:  if false;      // Admin SDK uniquement
    }


    // ═══ TÉMOIGNAGES — mur de témoignages clients ═══
    //
    // Deux publics, une seule collection :
    //   • l'équipe connectée voit TOUT (isAuth) — mur interne, archives
    //     comprises ;
    //   • le monde entier ne voit que ce qui a été explicitement publié.
    //
    // Le champ s'appelle `isPublic` et non `public` : on ne pariera pas sur
    // le statut de mot réservé de `public` dans le langage des rules.
    //
    // La condition publique porte sur `resource.data` : Firestore n'accepte
    // alors une requête de LISTE que si elle contraint elle-même ces deux
    // champs. temoignages-public.html interroge donc obligatoirement
    //     .where('isPublic','==',true).where('archived','==',false)
    // et toute autre requête anonyme est rejetée — c'est ce qui garantit
    // qu'un témoignage interne ne peut pas fuiter par la page publique.
    // Deux filtres d'égalité : les index simples automatiques suffisent,
    // aucun index composite à créer.
    //
    // `archived == false` (et pas `!= true`) est volontaire : le champ est
    // toujours écrit à la création, un document sans le champ resterait
    // invisible côté public plutôt que d'être exposé par accident.
    //
    // Écriture : tout membre connecté dépose et édite — coachs et CSM
    // compris, ce sont eux qui reçoivent le plus de retours clients.
    // MAIS le champ `isPublic` reste la chasse gardée des admins : c'est lui
    // qui décide de ce qu'un prospect voit sur le lien partageable.
    //   • create : un admin fait ce qu'il veut ; tout autre membre à la
    //     condition que le document naisse NON public. Un non-admin ne peut
    //     donc pas faire entrer quelque chose sur le mur externe, même en
    //     une seule écriture.
    //   • update : un admin fait ce qu'il veut ; un non-admin ne passe que
    //     s'il laisse `isPublic` strictement identique à ce qu'il était.
    //     Il peut donc renommer, recatégoriser, épingler, archiver — jamais
    //     publier ni dépublier.
    // Corollaire assumé : archiver un témoignage déjà public ne le dépublie
    // pas côté non-admin. Sans conséquence, le mur public exige aussi
    // archived == false.
    //
    // L'import Drive (api/temoignages-drive-sync.js) passe par l'Admin SDK
    // et contourne naturellement ces rules.
    // Suppression : jamais. On archive (archived:true), le document et son
    // blob Storage restent — règle métier du repo.
    match /testimonials/{temoId} {
      allow read:   if isAuth()
                    || (resource.data.isPublic == true
                        && resource.data.archived == false);
      allow create: if isAdmin()
                    || (isAuth()
                        && request.resource.data.isPublic == false);
      allow update: if isAdmin()
                    || (isAuth()
                        && request.resource.data.isPublic == resource.data.isPublic);
      allow delete: if false;
    }

  }
}
