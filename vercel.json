{
  "crons": [
    {
      "path": "/api/ringover-sync-cron",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/tunnel-visits-purge",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/meet-recordings-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/availability-snapshot",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/replay-closing",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/whatsapp-rappels-rdv",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/temoignages-drive-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/instagram-sync-cron",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/facebook-sync-cron",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/ai-lead",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ai-morning-brief?slot=6",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/ai-morning-brief?slot=7",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/ai-closing-prep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/ai-followup",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/ai-client-risk",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/ai-call",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ai-call?job=stats",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/ai-setter-feedback",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/ai-watchdog",
      "schedule": "40 5 * * *"
    },
    {
      "path": "/api/mail-health-cron",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/lead-reply-watch",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/user-activity",
      "schedule": "20 2 1 * *"
    },
    {
      "path": "/api/gmail-inbound-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/client-demarrage",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/coaching-replays-groupe",
      "schedule": "15 5 * * *"
    }
  ],
  "functions": {
    "api/{admin-backfill-attribution,ai-command,ai-invoice-check,ai-message,availability-snapshot,booking-recurrence-plan,client-statement,client-statement-send,csm-cockpit,facebook-webhook}.js": {
      "maxDuration": 60
    },
    "api/{formations-drive,gmail-inbound-sync,instagram-webhook,invoice-qonto-sync,invoice-validate,mail-health-cron,mcp,rdv-presence,replay-closing-video,scoring,sign-session}.js": {
      "maxDuration": 60
    },
    "api/{subscription-generate-invoice,team-pilotage,whatsapp-webhook}.js": {
      "maxDuration": 60
    },
    "api/{admin-sync-ringover-calls,ai-call,ai-client-risk,ai-closing-prep,ai-followup,ai-lead,ai-setter-feedback,ai-watchdog,booking-series-create,coaching-plan-revise,coaching-plan-suggest}.js": {
      "maxDuration": 300
    },
    "api/{contract-studio,facebook-sync-cron,instagram-sync-cron,replay-closing,temoignages-drive-sync}.js": {
      "maxDuration": 300
    },
    "api/{tunnel-preview,tunnel-render}.js": {
      "includeFiles": "tunnel-runtime.js"
    },
    "api/{ai-ask,ai-attribution,ai-morning-brief,ai-objections,coaching-replays-groupe,payments-unpaid}.js": {
      "maxDuration": 120
    },
    "api/{ai-session-report,ai-training}.js": {
      "maxDuration": 90
    }
  },
  "routes": [
    {
      "src": "^/(?!api/)(.*)$",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.adrienemily\\.com|adrienemily\\.com)$"
        }
      ],
      "dest": "/api/tunnel-render?__p=$1"
    },
    {
      "src": "^/t/(.*)$",
      "dest": "/api/tunnel-render?__p=$1&__t=1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/mcp/([A-Za-z0-9]{32,128})/?$",
      "dest": "/api/mcp?key=$1"
    },
    {
      "src": "^/g/([^/]+)$",
      "dest": "/api/group-redirect?id=$1"
    },
    {
      "src": "^/m/([A-Za-z0-9_-]{5,64})/?$",
      "dest": "/api/meet-link?id=$1"
    },
    {
      "src": "^/f/([A-Za-z0-9_-]+)/?$",
      "dest": "/alteoforms-render.html"
    }
  ]
}
