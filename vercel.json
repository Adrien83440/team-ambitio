    "api/instagram-sync-cron.js": {
      "maxDuration": 300
    },
    "api/instagram-webhook.js": {
      "maxDuration": 60
    },
    "api/facebook-sync-cron.js": {
      "maxDuration": 300
    },
    "api/facebook-webhook.js": {
      "maxDuration": 60
    }
