{
  "crons": [
    {
      "path": "/api/ringover-sync-cron",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/meet-recordings-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/availability-snapshot",
      "schedule": "20 4 * * *"
    },
    {
