    "api/admin-backfill-attribution.js": {
      "maxDuration": 60
    },
    "api/admin-sync-ringover-calls.js": {
      "maxDuration": 300
    },
    "api/coaching-plan-suggest.js": {
      "maxDuration": 300
    },
    "api/coaching-plan-revise.js": {
      "maxDuration": 300
    },
    "api/temoignages-drive-sync.js": {
      "maxDuration": 300
    },
    "api/whatsapp-webhook.js": {
      "maxDuration": 60
