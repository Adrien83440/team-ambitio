  "routes": [
    {
      "src": "^/(?!api/)(.*)$",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.adrienemily\\.com|adrienemily\\.com)$"
        }
      ],
      "dest": "/api/tunnel-render?__p=$1"
    },
    {
      "src": "^/t/(.*)$",
      "dest": "/api/tunnel-render?__p=$1&__t=1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/g/([^/]+)$",
      "dest": "/api/group-redirect?id=$1"
    },
    {
      "src": "^/f/([A-Za-z0-9_-]+)/?$",
      "dest": "/alteoforms-render.html"
    }
  ]
